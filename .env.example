# ==========================================
# FRONTEND ENVIRONMENT VARIABLES (Vercel)
# ==========================================
# Set this on Vercel to your deployed Render backend URL (e.g. https://apex-f1-backend.onrender.com/api)
VITE_API_URL=http://localhost:3000/api

# ==========================================
# BACKEND ENVIRONMENT VARIABLES (Render / backend/.env)
# ==========================================
PORT=3000
OPENAI_API_KEY=your_openai_api_key_here
NEWS_API_KEY=your_news_api_key_here
RAPIDAPI_KEY=your_rapidapi_key_here
RAPIDAPI_HOST=f1-live-pulse.p.rapidapi.com
# Phone telemetry service: point this at persistent phone storage.
# Example for Termux: /data/data/com.termux/files/home/apex-f1-cache
APEX_CACHE_ROOT=/persistent/storage/apex-f1
TELEMETRY_CACHE_VERSION=v1
TELEMETRY_GENERATION_WORKERS=1
# Optional comma-separated demo races to generate after service startup.
PREWARM_RACES=2025-1,2025-6
